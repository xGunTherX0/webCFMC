# --- Formulario de contacto (Formspree) ---
# 1. Creá una cuenta gratis en https://formspree.io con el correo contactowebcfmcweb@gmail.com
# 2. Creá un formulario nuevo y copiá el ID que aparece en la URL:
#    https://formspree.io/f/ABC123xyz  ->  el ID es "ABC123xyz"
# Sin esta variable, el formulario abre el cliente de correo del visitante
# con destino a contactowebcfmcweb@gmail.com.
NEXT_PUBLIC_FORMSPREE_ID=

# --- TinaCMS (solo necesarios para editar contenido desde /admin en producción) ---
# Se obtienen desde https://app.tinacms.org con el proyecto conectado a GitHub.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# --- Rama de TinaCMS (opcional) ---
TINA_BRANCH=main
